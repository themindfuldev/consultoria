rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // The email verified by the trainer's passwordless sign-in link.
    function authEmail() {
      return isSignedIn() ? request.auth.token.email : null;
    }

    // True when the caller is the trainer identified by `email` (non-empty match
    // against their verified email-link identity).
    function isTrainerFor(email) {
      return isSignedIn() && email != null && email != '' && authEmail() == email;
    }

    function isOwner(studentUid) {
      return isSignedIn() && request.auth.uid == studentUid;
    }

    // The caller's verified email, lowercased — the key used in the allowlist.
    function authEmailLower() {
      return isSignedIn() && authEmail() != null ? authEmail().lower() : null;
    }

    // True when the caller's email has been manually approved (an allowlist doc
    // exists for it). Entries are added/removed only from the Firebase console.
    function isApproved() {
      return authEmailLower() != null
        && exists(/databases/$(database)/documents/allowlist/$(authEmailLower()));
    }

    // True when the caller is any confirmed trainer (a `trainers/{email}` doc
    // exists for their verified email). Used to gate who may review the
    // pending-registration queue.
    function isTrainerAdmin() {
      return authEmailLower() != null
        && exists(/databases/$(database)/documents/trainers/$(authEmailLower()));
    }

    // ── Allowlist (console-managed registration approvals) ─────────────────────
    match /allowlist/{email} {
      // A signed-in user may read only their own entry, so the app can tell
      // whether they've been approved. All writes happen in the console.
      allow read: if isSignedIn() && email == authEmailLower();
      allow write: if false;
    }

    // ── Access requests (pending-approval queue, keyed by uid) ─────────────────
    match /access_requests/{uid} {
      // The requester may read/clear their own entry; any trainer can review the
      // queue and clear entries as they approve or reject them.
      allow read, delete: if isOwner(uid) || isTrainerAdmin();
      // A not-yet-approved user records exactly one request under their own uid.
      // No updates — the doc is a one-shot marker (its existence also stops the
      // app from re-sending the notification email on repeat visits).
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if false;
    }

    // ── Users (students only) ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read, update, delete: if isOwner(uid);
      // New registrations require manual approval: a first-time student can only
      // create their profile once their email is on the allowlist. Existing
      // students already hold a doc, so they are unaffected.
      allow create: if isOwner(uid) && isApproved();
    }

    // ── Trainers (global, keyed by email) ──────────────────────────────────────
    match /trainers/{email} {
      // Students need to read to check existence/status when registering.
      allow read: if isSignedIn();
      // A student creates a pending trainer record they own the "createdBy" of.
      allow create: if isSignedIn()
        && request.resource.data.createdByStudentUid == request.auth.uid
        && request.resource.data.id == email;
      // Only the trainer (verified email) can update their record; email is the
      // immutable doc id, so it can never change.
      allow update: if isTrainerFor(email);
      allow delete: if false;
    }

    // ── Student ↔ Trainer links ────────────────────────────────────────────────
    match /student_trainers/{docId} {
      allow read: if isOwner(resource.data.studentUid)
        || isTrainerFor(resource.data.trainerEmail);
      allow create: if isOwner(request.resource.data.studentUid);
      allow update: if isOwner(resource.data.studentUid);
      allow delete: if isOwner(resource.data.studentUid);
    }

    // ── Cycles ─────────────────────────────────────────────────────────────────
    match /cycles/{cycleId} {
      allow read: if isOwner(resource.data.studentUid)
        || isTrainerFor(resource.data.trainerEmail);
      allow create: if isOwner(request.resource.data.studentUid);
      allow update, delete: if isOwner(resource.data.studentUid);

      // Cycle weeks — student manages; trainer may read.
      match /weeks/{weekId} {
        allow read: if isOwner(cycleData().studentUid)
          || isTrainerFor(cycleData().trainerEmail);
        allow write: if isOwner(cycleData().studentUid);
      }

      // Progress photo folders — student manages; trainer may read.
      match /progressPhotoFolders/{folderId} {
        allow read: if isOwner(cycleData().studentUid)
          || isTrainerFor(cycleData().trainerEmail);
        allow write: if isOwner(cycleData().studentUid);
      }
      function cycleData() {
        return get(/databases/$(database)/documents/cycles/$(cycleId)).data;
      }
    }

    // ── Sessions ───────────────────────────────────────────────────────────────
    match /sessions/{docId} {
      allow read: if isOwner(resource.data.studentUid)
        || isTrainerFor(resource.data.trainerEmail);
      allow create: if isOwner(request.resource.data.studentUid);
      // Student owns their session; the trainer may update it (e.g. feedbackStatus).
      allow update: if isOwner(resource.data.studentUid)
        || isTrainerFor(resource.data.trainerEmail);
      allow delete: if isOwner(resource.data.studentUid);
    }

    // ── Session exercises (actuals cache) ──────────────────────────────────────
    match /session_exercises/{docId} {
      allow read: if isOwner(resource.data.studentUid)
        || isTrainerFor(resource.data.trainerEmail);
      allow create: if isOwner(request.resource.data.studentUid);
      allow update, delete: if isOwner(resource.data.studentUid);
    }

    // ── Videos ─────────────────────────────────────────────────────────────────
    match /videos/{docId} {
      allow read: if isOwner(resource.data.studentUid)
        || isTrainerFor(resource.data.trainerEmail);
      allow create: if isOwner(request.resource.data.studentUid);
      allow update, delete: if isOwner(resource.data.studentUid);
    }

    // ── Feedback (trainer writes; student reads) ───────────────────────────────
    match /feedback/{docId} {
      allow read: if isOwner(resource.data.studentUid)
        || isTrainerFor(resource.data.trainerEmail);
      // The authoring trainer must stamp their own verified email on the doc.
      allow create, update: if isTrainerFor(request.resource.data.trainerEmail);
    }
  }
}
